# Settings for scripts/verify_cluster_usecases.py: which clusters to test and
# how to reach them. Copy this file somewhere outside the repository, fill in
# what applies, and load it before running the script:
#
#     cp scripts/cluster_test.env.example ~/.clustrix-test.env
#     $EDITOR ~/.clustrix-test.env
#     set -a; . ~/.clustrix-test.env; set +a
#     python scripts/verify_cluster_usecases.py --check
#
# A target whose HOST line is left commented out is skipped. No secret has to
# be written here: use a key file or the ssh-agent, and `hf auth login` (or
# HF_TOKEN in your shell) for HuggingFace. If you do put a password in your
# copy, keep the copy private (chmod 600) and never commit it.
#
# Host keys are verified. Connect to each host once with plain `ssh` first so
# it is in ~/.ssh/known_hosts.

# The login name, when it is the same everywhere. A target's own _USER wins.
#CLUSTRIX_TEST_USERNAME=

# --- gpu-1: one machine with GPUs, reached over SSH (no scheduler) ----------
#CLUSTRIX_TEST_SSH_HOST=gpu.example.edu
#CLUSTRIX_TEST_SSH_PORT=22
#CLUSTRIX_TEST_SSH_USER=
# A private key file. Without one: CLUSTRIX_GPU_PASSWORD, else the ssh-agent
# and your default keys.
#CLUSTRIX_TEST_SSH_KEY=~/.ssh/id_ed25519
# How many GPUs one job may ask for there. 0 skips the GPU cases.
#CLUSTRIX_TEST_SSH_GPUS=1
# Space-separated `module load` names needed before Python or CUDA work.
#CLUSTRIX_TEST_SSH_MODULES=
# An existing conda environment to run in, instead of one clustrix builds.
# The way to get PyTorch with CUDA onto the worker if it is not installed
# on this machine.
#CLUSTRIX_TEST_SSH_ENV=
# Where job files go on the host. Default: ~/.clustrix/usecases
#CLUSTRIX_TEST_SSH_REMOTE_DIR=

# --- slurm-1: a SLURM cluster, reached through its login node ---------------
#CLUSTRIX_TEST_SLURM_HOST=login.example.edu
#CLUSTRIX_TEST_SLURM_PORT=22
#CLUSTRIX_TEST_SLURM_USER=
#CLUSTRIX_TEST_SLURM_KEY=~/.ssh/id_ed25519
# The partition to submit to. Unset: the cluster's default.
#CLUSTRIX_TEST_SLURM_PARTITION=
# How many GPUs one job may request (`#SBATCH --gres=gpu:N`) in that
# partition. Leave at 0 unless the partition has GPUs: sbatch refuses a gres
# the cluster does not have.
#CLUSTRIX_TEST_SLURM_GPUS=0
#CLUSTRIX_TEST_SLURM_MODULES=
#CLUSTRIX_TEST_SLURM_ENV=
# Must be on a filesystem the compute nodes see. Default: ~/clustrix_usecases
#CLUSTRIX_TEST_SLURM_REMOTE_DIR=

# A second machine of either kind: the same names with _2 at the end, e.g.
#CLUSTRIX_TEST_SSH_HOST_2=
#CLUSTRIX_TEST_SLURM_HOST_2=

# --- hf: HuggingFace Jobs ---------------------------------------------------
# The account or organisation that is billed. Unset: the token's own account.
#CLUSTRIX_HF_NAMESPACE=
# hf-gpu rents this hardware for a few minutes, and runs only when it is
# named. `hf jobs hardware` lists the choices and prices.
#CLUSTRIX_TEST_HF_GPU_FLAVOR=t4-small
